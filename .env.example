# ipv6-proxy 配置示例
#
# 正常部署**不需要手写这个文件**——deploy.sh 会生成 /etc/ipv6-proxy/env，
# 口令随机生成、前缀自动探测。这份示例是给两种情况用的：
#   1. 想知道有哪些旋钮可调
#   2. 不用 deploy.sh，自己手工跑二进制
#
# 手工用法：
#   cp .env.example .env && vim .env
#   set -a && . ./.env && set +a && ./ipv6-proxy
#
# 格式就是逐行 KEY=VALUE。**值不要加引号**——这个文件同时被
# systemd 的 EnvironmentFile 和 deploy.sh 的 sed 读取，
# 加了引号会被当成值的一部分。

# ─────────────── 必填 ───────────────

# 出口地址所属的 IPv6 前缀（CIDR）。留空则启动时自动探测。
#
# ⚠️ 强烈建议显式写死。自动探测只能看到网卡上宣告的前缀（通常是 /64），
# 如果服务商路由给你的是 /56，落在其他 /64 的地址会被误判为越界。
PROXY_IPV6_PREFIX=2604:2dc0:143:8200::/56

# 代理口令。留空则每次启动随机生成并打印到日志（重启就变，客户端会全部失效）。
# 不能含冒号：HTTP Basic 按第一个冒号拆 user:pass，含冒号会错位。
PROXY_PASSWORD=换成一个强口令

# ─────────────── 管理面 ───────────────

# 管理面监听地址。默认 0.0.0.0:6081（开启）。
#
# ⚠️ 管理面能改白名单——改成 * 就等于把这台机器变成公网开放代理，
#    别人拿你的 IP 做什么，溯源都指向你。而且它走的是明文 HTTP，
#    口令可被链路上的中间人嗅探。
#
# 三个选择：
#   0.0.0.0:6081      公网可达（默认）。务必配防火墙限定来源 IP：
#                     ufw allow from <你的固定IP> to any port 6081 proto tcp
#   127.0.0.1:6081    只听本地，用 SSH 隧道访问（最安全）：
#                     ssh -L 6081:127.0.0.1:6081 root@服务器
#   off               完全关闭
PROXY_ADMIN_LISTEN=0.0.0.0:6081

# 管理面口令。留空则随机生成并打印到日志。
#
# ⚠️ 必须与 PROXY_PASSWORD 不同，否则启动直接失败。
#    管理面在线改口令时两个方向都会做交叉校验，拦住这种情况。
#    建议 12 位起——它能改白名单，比代理口令更值得保护。
PROXY_ADMIN_PASSWORD=换成另一个强口令

# 配置文件路径，指向本文件自身的最终位置。
# 管理面靠它持久化在线修改；不设的话改动只在内存里，重启就没了。
PROXY_ENV_FILE=/etc/ipv6-proxy/env

# ─────────────── 可选 ───────────────

# 代理监听地址。SOCKS5 与 HTTP CONNECT 共用这一个端口
# （靠首字节区分：0x05 是 SOCKS5，ASCII 字母是 HTTP）。
# 想收敛暴露面就改成 127.0.0.1:6080 走 SSH 隧道。
#PROXY_LISTEN=0.0.0.0:6080

# 目标白名单，逗号分隔。支持 *.example.com 形态的后缀匹配
# （按标签边界匹配，*.openai.com 不会放行 evilopenai.com）。
#
# ⚠️ 填 * 表示不限制。那样一旦口令泄漏，别人就能用你的 IP 访问任意站点。
#    限定之后即便泄漏，滥用价值也接近零——这是公网开放代理唯一的实质缓解。
#PROXY_ALLOWED_HOSTS=chatgpt.com,*.chatgpt.com,*.openai.com

# 连接上游的超时。支持 "15s" 和裸秒数 "15" 两种写法。
#PROXY_DIAL_TIMEOUT=15s

# 空闲连接回收时间。CONNECT 隧道可能长时间静默，别设太短。
#PROXY_IDLE_TIMEOUT=300s

# 同时在线连接上限，防止把文件描述符吃光。
#PROXY_MAX_CONNS=256
